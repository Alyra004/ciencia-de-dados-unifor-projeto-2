# Dados e arquivos pesados
dados/raw/*
!dados/raw/.gitkeep

dados/processed/*
!dados/processed/.gitkeep

dados/splits/*
!dados/splits/.gitkeep

*.csv
*.zip

# Exceção para identificadores das partições (splits salvos no repositório)
!dados/splits/*.csv

# Exceção para os resultados leves exigidos no repositório (experimentos, tabelas)
!resultados/*.csv
!resultados/tabelas/*.csv


# Python e ambientes virtuais
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDEs e sistema operacional
.vscode/
.idea/
.DS_Store
Thumbs.db
